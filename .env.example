# URLs dos serviços de backend — server-only (nunca NEXT_PUBLIC_): toda chamada passa por uma
# rota do próprio Next (BFF), o browser nunca fala direto com -dados/-clientes.
DADOS_API_URL=http://localhost:8000
CLIENTES_API_URL=http://localhost:8080

# Autenticação — decisão fechada (ver decisoes-produto.md e
# indicadores-credito-infra/docs/contrato-autenticacao.md): cookie httpOnly guardando o JWT
# emitido por -clientes, sem segredo próprio do frontend (não emite nem assina token).
